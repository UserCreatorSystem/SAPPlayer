      <include name="java"/>
      <include name="resources"/>
    </dirset>
  </path>
  
  
  <target name="compile.module.pl.sapplayer.sapplayer.main" depends="compile.module.pl.sapplayer.sapplayer.main.production,compile.module.pl.sapplayer.sapplayer.main.tests" description="Compile module pl.sapplayer.SAPPlayer.main"/>
  
  <target name="compile.module.pl.sapplayer.sapplayer.main.production" depends="register.custom.compilers" description="Compile module pl.sapplayer.SAPPlayer.main; production classes">
    <mkdir dir="${pl.sapplayer.sapplayer.main.output.dir}"/>
    <javac2 destdir="${pl.sapplayer.sapplayer.main.output.dir}" debug="${compiler.debug}" nowarn="${compiler.generate.no.warnings}" memorymaximumsize="${compiler.max.memory}" fork="true" executable="${module.jdk.bin.pl.sapplayer.sapplayer.main}/javac">
