  </path>
  
  <path id="pl.sapplayer.sapplayer.main.module.production.classpath">
    <path refid="${module.jdk.classpath.pl.sapplayer.sapplayer.main}"/>
    <path refid="library.gradle:_net.sf.asap:asap:.classpath"/>
  </path>
  
  <path id="pl.sapplayer.sapplayer.main.runtime.production.module.classpath">
    <pathelement location="${pl.sapplayer.sapplayer.main.output.dir}"/>
    <path refid="library.gradle:_net.sf.asap:asap:.classpath"/>
  </path>
  
  <path id="pl.sapplayer.sapplayer.main.module.classpath">
    <path refid="${module.jdk.classpath.pl.sapplayer.sapplayer.main}"/>
    <pathelement location="${pl.sapplayer.sapplayer.main.output.dir}"/>
    <path refid="library.gradle:_net.sf.asap:asap:.classpath"/>
  </path>
  
  <path id="pl.sapplayer.sapplayer.main.runtime.module.classpath">
