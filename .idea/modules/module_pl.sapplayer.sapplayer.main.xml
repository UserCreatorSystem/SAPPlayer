      </fileset>
      <fileset dir="${module.pl.sapplayer.sapplayer.main.basedir}/../../src/main/resources">
        <patternset refid="compiler.resources"/>
        <type type="file"/>
      </fileset>
    </copy>
  </target>
  
  <target name="compile.module.pl.sapplayer.sapplayer.main.tests" depends="register.custom.compilers,compile.module.pl.sapplayer.sapplayer.main.production" description="compile module pl.sapplayer.SAPPlayer.main; test classes" unless="skip.tests"/>
  
  <target name="clean.module.pl.sapplayer.sapplayer.main" description="cleanup module">
