  <property name="module.jdk.home.pl.sapplayer.sapplayer.main" value="${project.jdk.home}"/>
  <property name="module.jdk.bin.pl.sapplayer.sapplayer.main" value="${project.jdk.bin}"/>
  <property name="module.jdk.classpath.pl.sapplayer.sapplayer.main" value="${project.jdk.classpath}"/>
  
  <property name="compiler.args.pl.sapplayer.sapplayer.main" value="-encoding UTF-8 -source 8 -target 1.8 ${compiler.args}"/>
  
  <property name="pl.sapplayer.sapplayer.main.output.dir" value="${module.pl.sapplayer.sapplayer.main.basedir}/../../out/production/classes"/>
