      <bootclasspath refid="pl.sapplayer.sapplayer.main.module.bootclasspath"/>
      <classpath refid="pl.sapplayer.sapplayer.main.module.production.classpath"/>
      <src refid="pl.sapplayer.sapplayer.main.module.sourcepath"/>
      <patternset refid="excluded.from.compilation.pl.sapplayer.sapplayer.main"/>
